#!/bin/zsh
# Launch a Windows game from the CrossOver "Steam" bottle, for use as a Mac Steam
# "non-Steam game" target. Stays running until the game exits so Big Picture
# knows when you're back.
#   bottle-launch steam <appid>          game installed through the bottle's Steam
#   bottle-launch exe "/path/to/game.exe"
#
# Talks to Console Mode through ~/Library/Application Support/Console Mode/session.json:
#   launching -> playing -> ended, and "resume-request" when this tile's game is suspended
#   (Quick Resume) so pressing Play resumes it instead of starting a second copy.
CX="/Applications/CrossOverGPTK4.app/Contents/SharedSupport/CrossOver/bin/wine"
STEAM='C:\Program Files (x86)\Steam\steam.exe'
LOG="$HOME/Library/Logs/ConsoleMode.log"
SESSION="$HOME/Library/Application Support/Console Mode/session.json"
HERE="${0:A:h}"
log() { echo "[bottle-launch $(date)] $*" >> "$LOG"; }
[[ "$1" == steam || "$1" == exe ]] || { echo "usage: bottle-launch steam <appid> | exe <path.exe>"; exit 2; }
TARGET="$1 $2"

# The tile's wrapper app tells us its name and Mac Steam shortcut id. Fallback: Mac Steam's
# SteamGameId (an unsigned 64-bit value, too big for shell arithmetic, so Python does the math).
SHORTCUT="${CM_TILE_SHORTCUT:-}"
[[ -z "$SHORTCUT" ]] && SHORTCUT=$(/usr/bin/python3 -c "import sys; print((int(sys.argv[1] or 0) >> 32) & 0xFFFFFFFF)" "${SteamGameId:-0}" 2>/dev/null || echo 0)
NAME="${CM_TILE_NAME:-}"
[[ -z "$NAME" ]] && NAME=$("$HERE/add-game" --lookup "$SHORTCUT" 2>/dev/null)
[[ -z "$NAME" ]] && NAME="${${2:t}%.exe}"
NOTICE="$HOME/Library/Application Support/Console Mode/notice.txt"

write_session() {   # state
  mkdir -p "${SESSION:h}"
  /usr/bin/python3 - "$SESSION" "$1" "$NAME" "$SHORTCUT" "$TARGET" "$START" <<'PY'
import json, os, sys
path, state, name, shortcut, target, start = sys.argv[1:]
tmp = path + ".tmp"
json.dump({"state": state, "name": name, "shortcut": int(shortcut), "target": target, "time": float(start)}, open(tmp, "w"))
os.replace(tmp, path)
PY
}
session_field() { /usr/bin/python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2],''))" "$SESSION" "$1" 2>/dev/null; }

wins() { "$HERE/bottle-windows" 2>/dev/null; }
# Is this exe running inside Wine? (Wine shows the Windows path as the command line.)
exe_running() { ps -Ao command | grep -iF "\\${2:t}" | grep -qv grep; }

# One game at a time, one copy of each: never collide.
STATE="$(session_field state)"; PREV_TARGET="$(session_field target)"; PREV_TIME="$(session_field time)"; PREV_TIME="${PREV_TIME:-0}"
recent=$(( $(date +%s) - ${PREV_TIME%.*} < 180 ))
if [[ "$STATE" == playing || ( "$STATE" == launching && $recent == 1 ) ]] && [[ -n "$(wins)" || $recent == 1 ]]; then
  if [[ "$PREV_TARGET" == "$TARGET" ]]; then
    log "$NAME is already ${STATE}: not starting a second copy"
    START="$PREV_TIME"; write_session focus-request
    exit 0
  elif [[ -n "$(wins)" || $recent == 1 ]]; then       # another game is running or still starting
    log "blocked $NAME: $(session_field name) is still running"
    mkdir -p "${NOTICE:h}"; echo "Close $(session_field name) first" > "$NOTICE"
    exit 1
  fi
fi
if [[ "$1" == exe ]] && exe_running "$1" "$2"; then
  log "$NAME is already running (found its process): not starting a second copy"
  START=$(date +%s); write_session focus-request
  exit 0
fi

# Quick Resume: this game is suspended -> ask Console Mode to resume it.
if [[ "$(session_field state)" == suspended && "$(session_field target)" == "$TARGET" ]]; then
  START=$(session_field time)
  write_session resume-request
  log "resume requested for $NAME"
else
  START=$(date +%s)
  write_session launching
  case "$1" in
    steam) "$CX" --bottle Steam --no-wait "$STEAM" -silent -applaunch "$2" >/dev/null 2>&1 ;;
    exe)   "$CX" --bottle Steam --no-wait --workdir "${2:h}" "$2" >/dev/null 2>&1 ;;
  esac
  log "launched $NAME ($TARGET)"
fi

# Wait for a game window from the bottle to appear (up to 3 min), then for it to go away.
for i in {1..180}; do [[ -n "$(wins)" ]] && break; sleep 1; done
if [[ -z "$(wins)" ]]; then log "no game window appeared"; write_session ended; exit 1; fi
[[ "$(session_field state)" == launching || "$(session_field state)" == resume-request ]] && write_session playing
log "game window: $(wins)"
gone=0
while (( gone < 3 )); do
  if [[ -z "$(wins)" ]]; then
    # Suspended by Quick Resume: the window is hidden, not gone. Let Steam show "Play" again.
    [[ "$(session_field state)" == suspended ]] && { log "$NAME suspended"; exit 0; }
    ((gone++))
  else
    gone=0
  fi
  sleep 2
done
write_session ended
log "game closed"
