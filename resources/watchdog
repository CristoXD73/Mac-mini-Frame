#!/bin/zsh
# Console Mode safety net (LaunchAgent, every 15s): if apps were paused for game mode and
# Console Mode is no longer running (crash, force quit), resume them. SIGCONT is harmless
# for processes that aren't paused, so this can't hurt anything.
F="$HOME/Library/Application Support/Console Mode/frozen.json"
[[ -f "$F" ]] || exit 0
pgrep -x ConsoleMode >/dev/null && exit 0
grep -oE '"pid" *: *[0-9]+' "$F" | grep -oE '[0-9]+$' | while read pid; do kill -CONT "$pid" 2>/dev/null; done
rm -f "$F"
echo "[watchdog $(date)] Console Mode not running: resumed paused apps" >> "$HOME/Library/Logs/ConsoleMode.log"
