#!/usr/bin/env python3
"""Back up the save files a game changed during a play session. Run by Console Mode when a game closes.

  backup-saves --since <unix time the game started> [--label "game.exe"]
  backup-saves --since <t> --dry-run      # show what would be backed up
  backup-saves --since <t> --keep 40      # keep more snapshots (Save Rewind runs this while you play)
  backup-saves --list-json                # every backed-up save folder and its snapshots, newest first
  backup-saves --restore "<snapshot dir>" # put a snapshot back (current save is snapshotted first)

The game's own save folders are only ever READ: nothing there is written, moved or deleted.
Each backup is copied into a temporary folder, verified file by file, then renamed into place,
so an interrupted or partial copy never looks like a real backup.
"""
import hashlib, json, os, shutil, sys, time

HOME = os.path.expanduser("~")
BOTTLE_USER = HOME + "/Library/Application Support/CrossOver/Bottles/Steam/drive_c/users/crossover"
BOTTLE_STEAM = HOME + "/Library/Application Support/CrossOver/Bottles/Steam/drive_c/Program Files (x86)/Steam"
def _config_value(key, default):
    """Optional settings from ~/Library/Application Support/Console Mode/config.json."""
    try:
        return json.load(open(os.path.expanduser("~/Library/Application Support/Console Mode/config.json"))).get(key, default)
    except (OSError, ValueError):
        return default


# Where backups go: config "backupDest" (a folder on another drive), CM_BACKUP_DEST for tests.
DEST_PRIMARY = os.environ.get("CM_BACKUP_DEST") or _config_value("backupDest", "/Volumes/Storage/Console Mode/Save Backups")
DEST_FALLBACK = HOME + "/Library/Application Support/Console Mode/Save Backups"
LOG = HOME + "/Library/Logs/ConsoleMode.log"
KEEP = 15                      # newest backups kept per save folder
MAX_GROUP_BYTES = 2 << 30      # skip anything over 2 GB: that's game data, not saves
MAX_GROUP_FILES = 5000

# (root, how many folder levels below it identify one game's save folder)
ROOTS = [
    (BOTTLE_USER + "/Saved Games", 2),
    (BOTTLE_USER + "/AppData/Roaming", 2),
    (BOTTLE_USER + "/AppData/Local", 2),
    (BOTTLE_USER + "/AppData/LocalLow", 2),
    # The bottle's Documents folder IS the Mac's ~/Documents, so only game-style folders there.
    (HOME + "/Documents/My Games", 1),
    (HOME + "/Documents", 2),
]
# Folders that are never saves (matched against any path component, case-insensitive).
SKIP_DIRS = {"cache", "caches", "shadercache", "shader cache", "gpucache", "d3dscache", "code cache", "webcache",
             "htmlcache", "temp", "tmp", "logs", "log", "crashdumps", "crashpad", "crashes", "crash reports",
             "microsoft", "steam", "crossover", "apple", "packages", "nvidia", "amd", "mesa", "d3dmetal", "wine",
             "my games" , "benchmarkresults", "screenshots", "videos", "mods"}
SKIP_EXT = (".log", ".dmp", ".tmp", ".lock", ".etl", ".cache", ".mdmp", ".part")
# Steam's own client data in userdata (settings, screenshots, controller configs), not games.
STEAM_CLIENT_APPS = {"7", "760", "241100"}
# Top-level ~/Documents folders that are never game saves.
DOCUMENTS_SKIP = {"codex", "claude", "projects", "github", "zoom", "microsoft user data", "adobe", "obsidian"}


def log(msg):
    try:        # logging must never be the reason a backup or restore fails
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as f:
            f.write(f"[backup-saves {time.ctime()}] {msg}\n")
    except OSError:
        pass


def skipped(rel_parts, name):
    return (any(p.lower() in SKIP_DIRS for p in rel_parts) or name.startswith(".") or name.lower().endswith(SKIP_EXT))


def walk(folder):
    """(relative path, size, mtime) for every file under folder that isn't cache/log noise. Never follows links."""
    out = []
    for dirpath, dirs, files in os.walk(folder, followlinks=False):
        rel_dir = os.path.relpath(dirpath, folder)
        parts = [] if rel_dir == "." else rel_dir.split(os.sep)
        dirs[:] = [d for d in dirs if d.lower() not in SKIP_DIRS and not d.startswith(".")]
        for name in files:
            if skipped(parts, name):
                continue
            p = os.path.join(dirpath, name)
            try:
                st = os.lstat(p)
            except OSError:
                continue
            out.append((os.path.relpath(p, folder), st.st_size, int(st.st_mtime)))
    return out


def changed_save_folders(since):
    """Save folders (at the right depth under each root) holding files modified since `since`."""
    groups = {}
    for root, depth in ROOTS:
        if not os.path.isdir(root):
            continue
        for dirpath, dirs, files in os.walk(root, followlinks=False):
            rel = os.path.relpath(dirpath, root)
            parts = [] if rel == "." else rel.split(os.sep)
            if root == HOME + "/Documents" and parts and parts[0].lower() in DOCUMENTS_SKIP | {"my games"}:
                dirs[:] = []; continue
            dirs[:] = [d for d in dirs if d.lower() not in SKIP_DIRS and not d.startswith(".")]
            if len(parts) > depth + 6:        # deep enough; saves are never this far down
                dirs[:] = []
            if len(parts) < depth:
                continue
            for name in files:
                if skipped(parts, name):
                    continue
                try:
                    if os.lstat(os.path.join(dirpath, name)).st_mtime >= since:
                        key = os.path.join(root, *parts[:depth])
                        groups[key] = (root, parts[:depth])
                        break
                except OSError:
                    pass
    # Steam Cloud saves: userdata/<account>/<appid>/remote
    for acct in _listdir(BOTTLE_STEAM + "/userdata"):
        for appid in _listdir(os.path.join(BOTTLE_STEAM, "userdata", acct)):
            remote = os.path.join(BOTTLE_STEAM, "userdata", acct, appid, "remote")
            if appid.isdigit() and appid not in STEAM_CLIENT_APPS and os.path.isdir(remote) and any(m >= since for _, _, m in walk(remote)):
                groups[remote] = ("Steam Cloud", [acct, appid])
    return groups


def _listdir(p):
    try:
        return os.listdir(p)
    except OSError:
        return []


def group_name(root, parts):
    base = root if root == "Steam Cloud" else os.path.basename(root.rstrip("/"))
    return " - ".join([base] + parts).replace("/", "_")


def manifest_hash(files):
    return hashlib.sha1(json.dumps(sorted(files)).encode()).hexdigest()


def backup(src, name, dest_root, dry_run, kind="auto", force=False):
    files = walk(src)
    total = sum(s for _, s, _ in files)
    if not files:
        return
    if total > MAX_GROUP_BYTES or len(files) > MAX_GROUP_FILES:
        log(f"skipped {name}: {len(files)} files / {total >> 20} MB is too big to be saves")
        return
    target_dir = os.path.join(dest_root, name)
    digest = manifest_hash(files)
    existing = sorted(d for d in _listdir(target_dir) if not d.startswith("."))
    if existing and not force:
        try:
            last = json.load(open(os.path.join(target_dir, existing[-1], ".manifest.json")))
            if last.get("hash") == digest:
                log(f"{name}: unchanged since last backup")
                return
        except (OSError, ValueError):
            pass
    stamp = time.strftime("%Y-%m-%d %H-%M-%S")
    n = 2
    while os.path.exists(os.path.join(target_dir, stamp)):     # several saves in the same second
        stamp = time.strftime("%Y-%m-%d %H-%M-%S") + f" ({n})"; n += 1
    if dry_run:
        print(f"would back up {name}: {len(files)} files, {total >> 10} KB -> {target_dir}/{stamp}")
        return
    tmp = os.path.join(target_dir, f".incoming-{stamp}")
    shutil.rmtree(tmp, ignore_errors=True)
    for rel, _, _ in files:
        s, d = os.path.join(src, rel), os.path.join(tmp, rel)
        os.makedirs(os.path.dirname(d), exist_ok=True)
        shutil.copy2(s, d, follow_symlinks=False)     # read source, write only into our own folder
    # Verify: same files, same sizes.
    copied = {r: s for r, s, _ in walk(tmp)}
    if any(copied.get(r) != s for r, s, _ in files):
        shutil.rmtree(tmp, ignore_errors=True)
        log(f"{name}: verification failed, backup discarded (source untouched)")
        return
    json.dump({"hash": digest, "source": src, "files": len(files), "bytes": total, "time": stamp, "kind": kind},
              open(os.path.join(tmp, ".manifest.json"), "w"))
    os.rename(tmp, os.path.join(target_dir, stamp))
    log(f"backed up {name}: {len(files)} files, {total >> 10} KB -> {target_dir}/{stamp}")
    return os.path.join(target_dir, stamp)
    # Retention: keep the newest KEEP backups of this save folder.
    for old in sorted(d for d in _listdir(target_dir) if not d.startswith("."))[:-KEEP]:
        shutil.rmtree(os.path.join(target_dir, old), ignore_errors=True)


def dest_roots():
    return [d for d in (DEST_PRIMARY, DEST_FALLBACK) if os.path.isdir(d)]


def list_json():
    out = []
    for root in dest_roots():
        for group in sorted(_listdir(root)):
            gdir = os.path.join(root, group)
            snaps = []
            for snap in sorted((d for d in _listdir(gdir) if not d.startswith(".")), reverse=True):
                try:
                    m = json.load(open(os.path.join(gdir, snap, ".manifest.json")))
                except (OSError, ValueError):
                    continue
                snaps.append({"dir": os.path.join(gdir, snap), "time": snap, "files": m.get("files"), "bytes": m.get("bytes"),
                              "kind": m.get("kind", "auto"), "source": m.get("source")})
            if snaps:
                out.append({"group": group, "source": snaps[0]["source"], "snapshots": snaps})
    print(json.dumps(out))


def allowed_source(src):
    """Restores may only write into a real save location: never anywhere else on disk."""
    src = os.path.realpath(src)
    roots = [os.path.realpath(r) for r, _ in ROOTS] + [os.path.realpath(BOTTLE_STEAM + "/userdata")]
    return any(src.startswith(r + os.sep) for r in roots) and src not in roots


def restore(snapshot):
    snapshot = os.path.realpath(snapshot)
    try:
        m = json.load(open(os.path.join(snapshot, ".manifest.json")))
    except (OSError, ValueError):
        return {"ok": False, "error": "not a Console Mode snapshot"}
    src = m.get("source", "")
    if not allowed_source(src):
        return {"ok": False, "error": f"refusing to restore outside save folders: {src}"}
    group_dir = os.path.dirname(snapshot)
    name = os.path.basename(group_dir)
    dest_root = os.path.dirname(group_dir)
    # 1. Snapshot what's there now, so the restore can be undone. Abort if that fails.
    if os.path.isdir(src) and walk(src):
        before = backup(src, name, dest_root, False, kind="before-restore", force=True)
        if not before:
            return {"ok": False, "error": "could not back up the current save first; nothing was changed"}
    wanted = {r: sz for r, sz, _ in walk(snapshot) if r != ".manifest.json"}
    # 2. Remove save files that didn't exist at that point (they're in the backup from step 1).
    for rel, _, _ in (walk(src) if os.path.isdir(src) else []):
        if rel not in wanted:
            os.remove(os.path.join(src, rel))
    # 3. Copy the snapshot back.
    for rel in wanted:
        d = os.path.join(src, rel)
        os.makedirs(os.path.dirname(d), exist_ok=True)
        shutil.copy2(os.path.join(snapshot, rel), d, follow_symlinks=False)
    # 4. Verify.
    now = {r: sz for r, sz, _ in walk(src)}
    ok = all(now.get(r) == sz for r, sz in wanted.items())
    log(f"restore {name} <- {os.path.basename(snapshot)}: {'ok' if ok else 'VERIFY FAILED'}")
    return {"ok": ok, "restored": os.path.basename(snapshot), "files": len(wanted)}


def main(argv):
    global KEEP
    if "--list-json" in argv:
        return list_json()
    if "--restore" in argv:
        print(json.dumps(restore(argv[argv.index("--restore") + 1])))
        return
    if "--keep" in argv:
        KEEP = max(1, int(argv[argv.index("--keep") + 1]))
    if "--since" not in argv:
        sys.exit(__doc__)
    since = float(argv[argv.index("--since") + 1]) - 60
    label = argv[argv.index("--label") + 1] if "--label" in argv else "game"
    dry = "--dry-run" in argv
    # The drive holding the backup folder must be connected (/Volumes/<drive>/...).
    parts = DEST_PRIMARY.split("/")
    drive = "/".join(parts[:3]) if DEST_PRIMARY.startswith("/Volumes/") else os.path.dirname(DEST_PRIMARY)
    dest = DEST_PRIMARY if os.path.isdir(drive) else DEST_FALLBACK
    if dest == DEST_FALLBACK and not dry:
        log("backup drive not connected: backing up to the internal drive instead")
    groups = changed_save_folders(since)
    if not groups:
        log(f"{label}: no changed saves found")
        if dry: print("no changed saves")
        return
    for src, (root, parts) in groups.items():
        try:
            backup(src, group_name(root, parts), dest, dry)
        except Exception as e:     # one bad folder must never stop the others
            log(f"error backing up {src}: {e}")


if __name__ == "__main__":
    main(sys.argv[1:])
