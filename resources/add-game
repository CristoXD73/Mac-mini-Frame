#!/usr/bin/env python3
"""Add a Windows game from the CrossOver "Steam" bottle to Mac Steam as a non-Steam game,
so it shows up in (native, GPU-rendered) Big Picture and launches through the bottle.

  add-game "Game Name" exe "/path/to/game.exe"
  add-game "Game Name" steam <appid>        # a game installed through the bottle's Steam
  add-game --list
  add-game --remove "Game Name"
  add-game --sync        # mirror every game installed in the bottle's Steam (Console Mode runs this)
  add-game --check       # exit code 10 if --sync has something to do (works while Steam is open)
  add-game --lookup <shortcut appid>   # print the tile's name (used by bottle-launch)
  add-game --uninstall   # remove every tile Console Mode created (and its art); your own shortcuts stay
  add-game --engine "Game Name" stock|gptk4   # which CrossOver/D3DMetal runs this game (Steam can stay open)

Mac Steam must be closed (it rewrites shortcuts.vdf on exit)."""
import glob, os, re, shlex, shutil, struct, subprocess, sys, zlib

LAUNCHER = os.path.join(os.path.dirname(os.path.abspath(__file__)), "bottle-launch")
# Mac Steam can only launch .app bundles as non-Steam games (anything else makes macOS ask which
# app should open it). Each tile therefore gets a tiny wrapper app that runs bottle-launch.
TILES = os.path.expanduser("~/Library/Application Support/Console Mode/Tiles")
USERDATA = os.path.expanduser("~/Library/Application Support/Steam/userdata")
BOTTLE = os.path.expanduser("~/Library/Application Support/CrossOver/Bottles/Steam")
BOTTLE_STEAM = os.environ.get("BOTTLE_STEAM_DIR", BOTTLE + "/drive_c/Program Files (x86)/Steam")
SYNC_TAG = "Bottle Steam"
# Redistributables and runtimes that install like games but aren't playable.
NOT_GAMES = {"228980", "1070560", "1391110", "1493710", "1628350", "1826330", "2180100"}


# Steam's binary VDF: 0x00 = nested map, 0x01 = string, 0x02 = int32, 0x08 = end of map.
def read_map(b, i):
    out = {}
    while b[i] != 0x08:
        t = b[i]; i += 1
        j = b.index(0, i); key = b[i:j].decode("utf-8", "replace"); i = j + 1
        if t == 0x00:
            out[key], i = read_map(b, i)
        elif t == 0x01:
            j = b.index(0, i); out[key] = b[i:j].decode("utf-8", "replace"); i = j + 1
        elif t == 0x02:
            out[key] = struct.unpack("<i", b[i:i + 4])[0]; i += 4
        else:
            raise ValueError(f"unknown VDF type {t:#x}")
    return out, i + 1


def write_map(m):
    out = b""
    for k, v in m.items():
        kb = k.encode() + b"\0"
        if isinstance(v, dict):
            out += b"\x00" + kb + write_map(v)
        elif isinstance(v, int):
            out += b"\x02" + kb + struct.pack("<i", v)
        else:
            out += b"\x01" + kb + str(v).encode() + b"\0"
    return out + b"\x08"


def shortcuts_files():
    return [os.path.join(d, "config", "shortcuts.vdf") for d in glob.glob(os.path.join(USERDATA, "*")) if d.split("/")[-1].isdigit() and d.split("/")[-1] != "0"]


def load(path):
    if not os.path.exists(path):
        return {}
    b = open(path, "rb").read()
    root, _ = read_map(b, 0)
    return root.get("shortcuts", {})


def save(path, shortcuts):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    ordered = {str(i): v for i, v in enumerate(shortcuts.values())}
    open(path, "wb").write(write_map({"shortcuts": ordered}) + b"\x08")


def wrapper_path(name):
    safe = "".join(ch if ch.isalnum() or ch in " -_." else "_" for ch in name).strip() or "Game"
    return os.path.join(TILES, safe + ".app")


ENGINES = {"gptk4": "/Applications/CrossOverGPTK4.app", "stock": "/Applications/CrossOver.app"}


def engine_of(name):
    """The engine a tile was set to (kept in its wrapper), default gptk4."""
    try:
        for line in open(os.path.join(wrapper_path(name), "Contents", "MacOS", "launch")):
            if line.startswith("export CM_CROSSOVER="):
                path = shlex.split(line.split("=", 1)[1])[0]
                return next((k for k, v in ENGINES.items() if v == path), "gptk4")
    except OSError:
        pass
    return "gptk4"


def shortcut_appid(name):
    return (zlib.crc32((f'"{wrapper_path(name)}"' + name).encode()) & 0xFFFFFFFF) | 0x80000000


def make_wrapper(name, launch_opts):
    """Write <Tiles>/<name>.app whose executable runs bottle-launch with this tile's target."""
    app = wrapper_path(name)
    macos = os.path.join(app, "Contents", "MacOS")
    os.makedirs(macos, exist_ok=True)
    kind, _, target = launch_opts.partition(" ")
    target = target.strip().strip('"')
    q = lambda v: "'" + v.replace("'", "'\\''") + "'"
    script = "\n".join([
        "#!/bin/zsh",
        f"# Console Mode tile for {name}: runs the game inside the CrossOver bottle.",
        f"export CM_TILE_NAME={q(name)}",
        f"export CM_TILE_SHORTCUT={shortcut_appid(name)}",
        f"export CM_CROSSOVER={q(ENGINES.get(engine_of(name), ENGINES['gptk4']))}",
        f"exec {q(LAUNCHER)} {kind} {q(target)}",
        ""])
    path = os.path.join(macos, "launch")
    open(path, "w").write(script); os.chmod(path, 0o755)
    bid = "local.consolemode.tile." + format(shortcut_appid(name), "x")
    plist = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleName</key><string>{name}</string>
<key>CFBundleIdentifier</key><string>{bid}</string>
<key>CFBundleExecutable</key><string>launch</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>LSUIElement</key><true/>
</dict></plist>
"""
    open(os.path.join(app, "Contents", "Info.plist"), "w").write(plist)
    subprocess.run(["codesign", "--force", "-s", "-", app], capture_output=True)
    return app


def entry(name, launch_opts, tags=("Windows (CrossOver)",)):
    app = make_wrapper(name, launch_opts)
    return {
        "appid": struct.unpack("<i", struct.pack("<I", shortcut_appid(name)))[0], "AppName": name, "Exe": f'"{app}"',
        "StartDir": f'"{TILES}"', "icon": "", "ShortcutPath": "", "LaunchOptions": "",
        "IsHidden": 0, "AllowDesktopConfig": 1, "AllowOverlay": 1, "OpenVR": 0, "Devkit": 0, "DevkitGameID": "",
        "DevkitOverrideAppID": 0, "LastPlayTime": 0, "FlatpakAppID": "", "tags": {str(i): t for i, t in enumerate(tags)},
        "ConsoleModeTarget": launch_opts,
    }


def target_of(v):
    """A tile's 'steam <appid>' / 'exe "<path>"' target: our own field, else the wrapper app's
    script (Steam may drop unknown fields when it rewrites the file), else old-style LaunchOptions."""
    if v.get("ConsoleModeTarget"):
        return v["ConsoleModeTarget"]
    script = os.path.join(v.get("Exe", "").strip('"'), "Contents", "MacOS", "launch")
    try:
        for line in open(script):
            if line.startswith("exec "):
                parts = shlex.split(line)[1:]          # [launcher, kind, target]
                if len(parts) == 3:
                    return f'{parts[1]} {parts[2]}' if parts[1] == "steam" else f'exe "{parts[2]}"'
    except OSError:
        pass
    return v.get("LaunchOptions", "")


def migrate(sc):
    """Older tiles pointed Steam straight at the bottle-launch script: give them wrapper apps."""
    changed = False
    for k, v in list(sc.items()):
        if v.get("Exe", "").strip('"') == LAUNCHER:
            sc[k] = entry(v["AppName"], v.get("LaunchOptions", ""), tuple(v.get("tags", {}).values()) or ("Windows (CrossOver)",))
            changed = True
    return changed


def vdf_values(text, key):
    return re.findall(r'"%s"\s+"([^"]*)"' % re.escape(key), text)


def mac_path(win):
    """C:\\foo or D:\\foo inside the bottle -> macOS path, via the bottle's drive letters."""
    win = win.replace("\\\\", "\\")
    if len(win) < 2 or win[1] != ":":
        return win
    drive = os.path.join(BOTTLE, "dosdevices", win[:2].lower())
    return os.path.realpath(drive) + win[2:].replace("\\", "/")


def bottle_games():
    """{appid: name} for every game installed in the bottle's Steam, across all its library folders."""
    try:
        folders = open(os.path.join(BOTTLE_STEAM, "steamapps", "libraryfolders.vdf"), encoding="utf-8").read()
    except OSError:
        return {}
    games = {}
    for lib in vdf_values(folders, "path"):
        lib = lib if lib.startswith("/") else mac_path(lib)
        for f in glob.glob(os.path.join(lib, "steamapps", "appmanifest_*.acf")):
            m = open(f, encoding="utf-8", errors="replace").read()
            ids, names = vdf_values(m, "appid"), vdf_values(m, "name")
            if ids and names and ids[0] not in NOT_GAMES:
                games[ids[0]] = names[0]
    return games


def copy_art(steam_appid, shortcut_id, grid_dir):
    """Reuse the cover art the bottle's Steam already downloaded (portrait, wide, hero, logo)."""
    cache = os.path.join(BOTTLE_STEAM, "appcache", "librarycache", steam_appid)
    wanted = {"library_600x900.jpg": f"{shortcut_id}p.jpg", "header.jpg": f"{shortcut_id}.jpg",
              "library_hero.jpg": f"{shortcut_id}_hero.jpg", "logo.png": f"{shortcut_id}_logo.png"}
    os.makedirs(grid_dir, exist_ok=True)
    for root, _, files in os.walk(cache):
        for f in files:
            if f in wanted and not os.path.exists(os.path.join(grid_dir, wanted[f])):
                shutil.copyfile(os.path.join(root, f), os.path.join(grid_dir, wanted[f]))


def sync(path, dry_run=False):
    """Make Mac Steam's tiles match the bottle's installed games. Only touches tiles it created.
    Returns True if anything needed changing."""
    sc = load(path)
    games = bottle_games()
    changed = False if dry_run else migrate(sc)
    if dry_run and any(v.get("Exe", "").strip('"') == LAUNCHER for v in sc.values()):
        return True
    ours = {target_of(v).split()[1]: k for k, v in sc.items()
            if SYNC_TAG in v.get("tags", {}).values() and target_of(v).startswith("steam ")}
    for appid, key in ours.items():
        if appid not in games:
            changed = True
            if dry_run: continue
            print(f"Removed {sc[key]['AppName']} (uninstalled)"); del sc[key]
    grid = os.path.join(os.path.dirname(path), "grid")
    if dry_run:
        return changed or any(a not in ours for a in games)
    for appid, name in games.items():
        if appid not in ours:
            sc[f"new{appid}"] = entry(name, f"steam {appid}", ("Windows (CrossOver)", SYNC_TAG))
            print(f"Added {name}"); changed = True
        copy_art(appid, shortcut_appid(name), grid)
    if changed:
        save(path, sc)
    else:
        print("Up to date")
    return changed


def main(argv):
    steam_open = not os.environ.get("CM_ASSUME_STEAM_CLOSED") and subprocess.run(["pgrep", "-x", "steam_osx"], capture_output=True).returncode == 0
    if steam_open and argv[:1] not in (["--list"], ["--check"], ["--lookup"], ["--engine"]):
        sys.exit("Quit Mac Steam first (Steam > Quit Steam), then run this again.")
    files = shortcuts_files()
    if not files:
        sys.exit("No Mac Steam user found; sign in to Steam once first.")
    for path in files:
        sc = load(path)
        if argv[:1] == ["--engine"] and len(argv) == 3:
            name, engine = argv[1], argv[2]
            if engine not in ENGINES:
                sys.exit(f"engine must be one of: {', '.join(ENGINES)}")
            tile = next((v for v in sc.values() if v.get("AppName") == name), None)
            if not tile:
                sys.exit(f"No tile named {name!r} (see --list)")
            script = os.path.join(wrapper_path(name), "Contents", "MacOS", "launch")
            lines = [l for l in open(script).read().splitlines() if not l.startswith("export CM_CROSSOVER=")]
            lines.insert(4, f"export CM_CROSSOVER='{ENGINES[engine]}'")
            open(script, "w").write("\n".join(lines) + "\n")
            subprocess.run(["codesign", "--force", "-s", "-", wrapper_path(name)], capture_output=True)
            print(f"{name} now runs on {engine} ({ENGINES[engine]})")
            continue
        if argv[:1] == ["--uninstall"]:
            ours = {k: v for k, v in sc.items()
                    if v.get("Exe", "").strip('"').startswith((TILES, LAUNCHER))}
            grid = os.path.join(os.path.dirname(path), "grid")
            for v in ours.values():
                aid = v.get("appid", 0) & 0xFFFFFFFF
                for pattern in (f"{aid}p.*", f"{aid}.*", f"{aid}_hero.*", f"{aid}_logo.*"):
                    for f in glob.glob(os.path.join(grid, pattern)):
                        os.remove(f)
                print(f"Removed {v.get('AppName')}")
            save(path, {k: v for k, v in sc.items() if k not in ours})
            shutil.rmtree(TILES, ignore_errors=True)
            continue
        if argv[:1] == ["--lookup"] and len(argv) == 2:
            want = int(argv[1]) & 0xFFFFFFFF
            for v in sc.values():
                if v.get("appid", 0) & 0xFFFFFFFF == want:
                    print(v.get("AppName", "")); return
            continue
        if argv[:1] == ["--check"]:
            if sync(path, dry_run=True):
                print("Sync needed"); sys.exit(10)
            print("Up to date")
        elif argv[:1] == ["--sync"]:
            sync(path)
        elif argv[:1] == ["--list"]:
            for v in sc.values():
                print(f"{v.get('AppName')}: {target_of(v)}  [{engine_of(v.get('AppName', ''))}]")
        elif argv[:1] == ["--remove"] and len(argv) == 2:
            sc = {k: v for k, v in sc.items() if v.get("AppName") != argv[1]}
            shutil.rmtree(wrapper_path(argv[1]), ignore_errors=True)
            save(path, sc); print(f"Removed {argv[1]}")
        elif len(argv) == 3 and argv[1] in ("exe", "steam"):
            name, kind, target = argv
            if kind == "exe" and not os.path.exists(target):
                sys.exit(f"Not found: {target}")
            opts = f'steam {target}' if kind == "steam" else f'exe "{target}"'
            sc = {k: v for k, v in sc.items() if v.get("AppName") != name}
            sc[str(len(sc))] = entry(name, opts)
            save(path, sc); print(f"Added {name} -> Big Picture")
        else:
            sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
