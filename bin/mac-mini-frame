#!/bin/bash
# Mac-mini-Frame — make Steam (desktop client and Big Picture) run smoothly
# inside a CrossOver bottle on macOS. Run `mac-mini-frame help` for usage.
set -eu

VERSION="0.1.0"

# Resolve our own directory, following symlinks (macOS has no readlink -f).
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
ROOT="$(cd -P "$(dirname "$src")/.." && pwd)"

# shellcheck source=SCRIPTDIR/../lib/common.sh
. "$ROOT/lib/common.sh"
# shellcheck source=SCRIPTDIR/../lib/cxconf.sh
. "$ROOT/lib/cxconf.sh"
# shellcheck source=SCRIPTDIR/../lib/flags.sh
. "$ROOT/lib/flags.sh"

STEAM_REG='HKCU\Software\Valve\Steam'
MACDRV_REG='HKCU\Software\Wine\Mac Driver'

usage() {
  cat <<EOF
Mac-mini-Frame $VERSION — speed up Steam in a CrossOver bottle on macOS

Usage: mac-mini-frame [--bottle NAME] [--dry-run] COMMAND [options]

Commands:
  doctor                 Check macOS, CrossOver, the bottle and Steam; list issues.
  apply [options]        Tune the bottle (backs everything up first). Quit Steam first.
      --backend B          Also set graphics backend: auto|d3dmetal|dxmt|dxvk|wined3d
      --keep-retina        Don't turn off High Resolution (Retina) mode
      --hud                Enable the Metal performance HUD (FPS overlay) in games
      --no-msync           Don't enable MSync
  launch [options]       Start Steam with low-lag flags.
      --profile P          lite (default) | nogpu | rescue | stock
      --bigpicture         Open straight into Big Picture (console UI)
      --fresh              Kill any stuck steamwebhelper/Steam first
      -- ARGS...           Extra arguments passed to steam.exe
  flags [--profile P] [--bigpicture]
                         Print the flags (paste into a CrossOver launcher's
                         "Command" field if you prefer launching from CrossOver).
  bench [--seconds N]    Sample steamwebhelper CPU/RAM while you use Steam, to
                         compare profiles objectively.
  kill                   Force-quit Steam and steamwebhelper in the bottle.
  restore [BACKUP]       Undo the last 'apply'; 'restore original' returns the
                         bottle to how it was before mac-mini-frame ever touched it.
  backups                List backups.
  help                   Show this help.

Environment:
  STEAM_BOTTLE  bottle name (default: Steam)      CX_APP  CrossOver.app path
  CX_BOTTLES    bottles directory                 NO_COLOR  disable colours
EOF
}

# --- doctor ----------------------------------------------------------------

cmd_doctor() {
  local issues=0 v

  info "== macOS"
  if command -v sw_vers >/dev/null 2>&1; then
    ok "macOS $(sw_vers -productVersion) ($(uname -m))"
    [ "$(uname -m)" = arm64 ] || warn "Intel Mac: D3DMetal/DXMT need Apple silicon; expect DXVK/wined3d only."
  else
    warn "Not running on macOS — doctor output will be limited."
  fi
  if command -v pmset >/dev/null 2>&1; then
    if pmset -g 2>/dev/null | grep -Eq 'lowpowermode[[:space:]]+1'; then
      warn "Low Power Mode is ON — it throttles CPU/GPU hard. Turn it off in System Settings > Battery."
      issues=$((issues + 1))
    else
      ok "Low Power Mode off"
    fi
  fi
  if [ "$(uname -m)" = arm64 ] && command -v pgrep >/dev/null 2>&1 && [ "$(uname -s)" = Darwin ]; then
    if [ -f /Library/Apple/usr/share/rosetta/rosetta ] || pgrep -q oahd 2>/dev/null; then
      ok "Rosetta 2 installed"
    else
      warn "Rosetta 2 not detected; CrossOver needs it: softwareupdate --install-rosetta --agree-to-license"
      issues=$((issues + 1))
    fi
  fi

  info ""; info "== CrossOver"
  if [ -d "$(cx_app)" ]; then
    v="$(plist_version "$(cx_app)/Contents/Info.plist")"
    ok "CrossOver ${v:-?} at $(cx_app)"
    case "$v" in
      1[0-9].*|2[0-3].*) warn "CrossOver $v is old; 24+ adds DXMT/D3DMetal improvements and Steam fixes."; issues=$((issues + 1)) ;;
    esac
  else
    err "CrossOver not found at $(cx_app)"; issues=$((issues + 1))
  fi
  if [ -d "$(cx_bottles)" ]; then
    info "Bottles:"
    (cd "$(cx_bottles)" && for b in */; do
       [ -f "$b/cxbottle.conf" ] && printf '   - %s\n' "${b%/}"
     done) || true
  fi

  info ""; info "== Bottle '$(bottle_name)'"
  if [ ! -f "$(bottle_conf)" ]; then
    err "Bottle not found. Pass --bottle NAME with one of the names above."
    return 1
  fi
  if steam_exe >/dev/null; then ok "Steam installed: $(steam_exe_win)"; else err "steam.exe not found in bottle"; issues=$((issues + 1)); fi

  v="$(cxconf_get "$(bottle_conf)" EnvironmentVariables WINEMSYNC || true)"
  if [ "$v" = 1 ]; then ok "MSync enabled"; else warn "MSync off (mac-mini-frame apply enables it)"; issues=$((issues + 1)); fi
  v="$(cxconf_get "$(bottle_conf)" EnvironmentVariables WINEDEBUG || true)"
  if [ "$v" = "-all" ]; then ok "Wine debug logging off"; else warn "Wine debug logging not disabled (costs CPU)"; issues=$((issues + 1)); fi
  v="$(cxconf_get "$(bottle_conf)" EnvironmentVariables CX_GRAPHICS_BACKEND || true)"
  ok "Graphics backend: ${v:-auto}"

  if [ -f "$(bottle_dir)/user.reg" ]; then
    if reg_has "$(bottle_dir)/user.reg" 'Software\Valve\Steam' GPUAccelWebViewsV3 'dword:00000000'; then
      ok "Steam GPU web-view acceleration off"
    else
      warn "Steam GPU web-view acceleration is on (main cause of UI lag under Wine)"; issues=$((issues + 1))
    fi
    if reg_has "$(bottle_dir)/user.reg" 'Software\Wine\Mac Driver' RetinaMode '"y"'; then
      warn "High Resolution (Retina) mode ON — Steam renders 4x the pixels in software"; issues=$((issues + 1))
    fi
  fi

  if proc_running 'steamwebhelper\.exe'; then
    info ""; info "== Running steamwebhelper processes"
    webhelper_stats | sed 's/^/   /'
  fi

  info ""
  if [ "$issues" -eq 0 ]; then ok "No issues found."; else warn "$issues issue(s). Quit Steam, then run: mac-mini-frame apply"; fi
  info ""
  dim "Also do once inside Steam (Settings):"
  dim "  Library   > Low Performance Mode: ON, Low Bandwidth Mode: ON, Community content: OFF"
  dim "  In Game   > Steam Overlay: OFF (it's another Chromium instance)"
  dim "  Downloads > Allow downloads during gameplay: OFF"
  dim "  Interface > 'Run Steam when my computer starts' off; notifications minimal"
  return 0
}

plist_version() {
  [ -f "$1" ] || return 0
  if command -v plutil >/dev/null 2>&1; then
    plutil -extract CFBundleShortVersionString raw -o - "$1" 2>/dev/null || true
  else
    grep -A1 CFBundleShortVersionString "$1" | sed -n 's/.*<string>\(.*\)<\/string>.*/\1/p' | head -1
  fi
}

# reg_has REGFILE KEY NAME VALUE — check a value in a Wine .reg hive, where
# keys are written with doubled backslashes: [Software\\Valve\\Steam] 1234
reg_has() {
  # Last occurrence wins, matching how Wine resolves duplicate entries.
  RH_KEY="$(printf '%s' "$2" | sed 's/\\/\\\\/g')" RH_NAME="\"$3\"=" RH_VAL="$4" awk '
    BEGIN { k = "[" tolower(ENVIRON["RH_KEY"]) "]"; n = tolower(ENVIRON["RH_NAME"]) }
    /^\[/ { in_key = (index(tolower($0), k) == 1); next }
    in_key && index(tolower($0), n) == 1 { v = substr($0, length(n) + 1); sub(/\r$/, "", v) }
    END { exit (tolower(v) == tolower(ENVIRON["RH_VAL"])) ? 0 : 1 }
  ' "$1"
}

# --- apply / restore -------------------------------------------------------

cmd_apply() {
  local backend="" retina=1 hud=0 msync=1 ts dest i
  while [ $# -gt 0 ]; do
    case "$1" in
      --backend) backend="${2:-}"; shift ;;
      --keep-retina) retina=0 ;;
      --hud) hud=1 ;;
      --no-msync) msync=0 ;;
      *) die "apply: unknown option $1" ;;
    esac
    shift
  done
  case "$backend" in ""|auto|d3dmetal|dxmt|dxvk|wined3d) ;; *) die "apply: bad --backend '$backend'" ;; esac

  require_bottle
  if proc_running 'steam\.exe' || proc_running 'steamwebhelper\.exe'; then
    die "Steam is running. Quit it first (or: mac-mini-frame kill)."
  fi

  # The first backup is also kept as "original" so repeated applies can
  # always get back to the untouched bottle.
  ts="$(date +%Y%m%d-%H%M%S)"
  dest="$(backup_dir)/$ts"
  i=1
  while [ -e "$dest" ]; do dest="$(backup_dir)/$ts-$i"; i=$((i + 1)); done
  backup_to "$dest"
  [ -e "$(backup_dir)/original" ] || backup_to "$(backup_dir)/original"
  ok "Backup saved: $dest"

  local conf; conf="$(bottle_conf)"
  set_env WINEDEBUG "-all"
  if [ "$msync" = 1 ]; then set_env WINEMSYNC 1; fi
  if [ "$hud" = 1 ]; then set_env MTL_HUD_ENABLED 1; fi
  case "$backend" in
    "") ;;
    auto) [ "${DRY_RUN:-0}" = 1 ] || cxconf_unset "$conf" EnvironmentVariables CX_GRAPHICS_BACKEND
          ok "graphics backend -> auto" ;;
    *) set_env CX_GRAPHICS_BACKEND "$backend" ;;
  esac

  require_wine
  # Steam's own Settings > Interface toggles, stored in the bottle registry.
  reg_dword "$STEAM_REG" GPUAccelWebViewsV3 0
  reg_dword "$STEAM_REG" SmoothScrollWebViews 0
  reg_dword "$STEAM_REG" DWriteEnable 0
  reg_dword "$STEAM_REG" H264HWAccel 0
  if [ "$retina" = 1 ]; then
    reg_sz "$MACDRV_REG" RetinaMode n
  fi

  info ""
  ok "Done. Launch with: mac-mini-frame launch   (or --bigpicture)"
}

backup_to() {
  run mkdir -p "$1"
  run cp -p "$(bottle_conf)" "$1/"
  if [ -f "$(bottle_dir)/user.reg" ]; then run cp -p "$(bottle_dir)/user.reg" "$1/"; fi
}

set_env() {
  if [ "${DRY_RUN:-0}" = 1 ]; then
    dim "[dry-run] cxbottle.conf: \"$1\" = \"$2\""
  else
    cxconf_set "$(bottle_conf)" EnvironmentVariables "$1" "$2"
  fi
  ok "$1=$2"
}

reg_dword() {
  cx_wine reg add "$1" /v "$2" /t REG_DWORD /d "$3" /f >/dev/null
  ok "$1\\$2 = $3"
}

reg_sz() {
  cx_wine reg add "$1" /v "$2" /t REG_SZ /d "$3" /f >/dev/null
  ok "$1\\$2 = $3"
}

cmd_backups() {
  require_bottle
  if [ -d "$(backup_dir)" ]; then ls -1 "$(backup_dir)"; else info "No backups."; fi
}

cmd_restore() {
  require_bottle
  local name="${1:-}" src
  if [ -z "$name" ]; then
    for src in "$(backup_dir)"/*; do
      case "${src##*/}" in original|'*') ;; *) name="${src##*/}" ;; esac
    done
    [ -n "$name" ] || die "No backups to restore."
  fi
  src="$(backup_dir)/$name"
  [ -f "$src/cxbottle.conf" ] || die "Backup '$name' not found."
  if proc_running 'steam\.exe' || proc_running 'steamwebhelper\.exe'; then
    die "Steam is running. Quit it first (or: mac-mini-frame kill)."
  fi
  run cp -p "$src/cxbottle.conf" "$(bottle_conf)"
  if [ -f "$src/user.reg" ]; then run cp -p "$src/user.reg" "$(bottle_dir)/user.reg"; fi
  ok "Restored backup $name"
}

# --- launch ----------------------------------------------------------------

parse_launch_opts() {
  PROFILE=lite; UI=desktop; FRESH=0; EXTRA=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --profile) PROFILE="${2:-}"; shift ;;
      --bigpicture|--big-picture|--console) UI=bigpicture ;;
      --fresh) FRESH=1 ;;
      --) shift; EXTRA="$*"; break ;;
      *) die "unknown option $1" ;;
    esac
    shift
  done
  profile_flags "$PROFILE" >/dev/null || die "unknown profile '$PROFILE' (choose: $PROFILES)"
}

build_flags() {
  local f
  f="$(profile_flags "$PROFILE") $(ui_flag "$UI") $EXTRA"
  # squeeze whitespace
  printf '%s' "$f" | tr -s ' ' | sed 's/^ //; s/ $//'
}

cmd_flags() {
  parse_launch_opts "$@"
  build_flags; printf '\n'
}

cmd_launch() {
  parse_launch_opts "$@"
  require_bottle
  require_wine
  local exe flags log
  exe="$(steam_exe_win)" || die "steam.exe not found in bottle '$(bottle_name)'."
  [ "$FRESH" = 1 ] && cmd_kill

  if proc_running 'steam\.exe'; then
    # Steam is already up: just ask it to switch UI.
    if [ "$UI" = bigpicture ]; then
      info "Steam already running — opening Big Picture."
      WINEDEBUG=-all cx_wine "$exe" "steam://open/bigpicture" >/dev/null 2>&1 &
    else
      warn "Steam is already running; flags only apply on a fresh start (use --fresh)."
    fi
    return 0
  fi

  flags="$(build_flags)"
  log="$(bottle_dir)/mac-mini-frame-launch.log"
  info "Launching Steam ($PROFILE${UI:+, $UI}) in bottle '$(bottle_name)'"
  dim "flags: $flags"
  # Intentional word splitting of $flags.
  # shellcheck disable=SC2086
  if [ "${DRY_RUN:-0}" = 1 ]; then
    WINEDEBUG=-all cx_wine "$exe" $flags
  else
    WINEDEBUG=-all nohup "$(cx_bin)/wine" --bottle "$(bottle_name)" "$exe" $flags >"$log" 2>&1 &
    ok "Started (pid $!). Log: $log"
  fi
}

cmd_kill() {
  local p
  for p in 'steamwebhelper\.exe' 'steam\.exe' 'gameoverlayui\.exe' 'steamservice\.exe'; do
    if proc_running "$p"; then run pkill -f "$(win_proc_re "$p")" || true; fi
  done
  # Give Wine a moment, then force anything left.
  if [ "${DRY_RUN:-0}" != 1 ]; then
    sleep 2
    for p in 'steamwebhelper\.exe' 'steam\.exe'; do
      if proc_running "$p"; then pkill -9 -f "$(win_proc_re "$p")" || true; fi
    done
  fi
  ok "Steam processes stopped."
}

# --- bench -----------------------------------------------------------------

webhelper_stats() {
  # %CPU and RSS(KB) summed across all steamwebhelper processes.
  ps -Ao pcpu=,rss=,command= 2>/dev/null | awk '
    $3 ~ /^[A-Za-z]:\\/ && /\\steamwebhelper\.exe/ { n++; cpu += $1; rss += $2 }
    END { printf "procs=%d cpu=%.1f%% rss=%.0fMB\n", n, cpu, rss / 1024 }'
}

cmd_bench() {
  local secs=30 i=0 line cpu_sum=0 cpu_max=0 rss_max=0 cpu rss
  while [ $# -gt 0 ]; do
    case "$1" in
      --seconds) secs="${2:-30}"; shift ;;
      *) die "bench: unknown option $1" ;;
    esac
    shift
  done
  proc_running 'steamwebhelper\.exe' || die "steamwebhelper isn't running — start Steam first."
  info "Sampling steamwebhelper for ${secs}s. Scroll the library / open Big Picture meanwhile."
  while [ "$i" -lt "$secs" ]; do
    line="$(webhelper_stats)"
    cpu="$(printf '%s' "$line" | sed 's/.*cpu=\([0-9.]*\)%.*/\1/')"
    rss="$(printf '%s' "$line" | sed 's/.*rss=\([0-9]*\)MB.*/\1/')"
    cpu_sum="$(awk -v a="$cpu_sum" -v b="$cpu" 'BEGIN{print a+b}')"
    cpu_max="$(awk -v a="$cpu_max" -v b="$cpu" 'BEGIN{print (b>a)?b:a}')"
    rss_max="$(awk -v a="$rss_max" -v b="$rss" 'BEGIN{print (b>a)?b:a}')"
    printf '\r  %2ds  %s   ' "$i" "$line"
    i=$((i + 1)); sleep 1
  done
  printf '\n'
  ok "$(awk -v s="$cpu_sum" -v n="$secs" -v m="$cpu_max" -v r="$rss_max" \
        'BEGIN{printf "avg CPU %.1f%%, peak CPU %.1f%%, peak RAM %dMB", s/n, m, r}')"
  dim "Lower is better. Compare: mac-mini-frame launch --fresh --profile lite|nogpu|stock"
}

# --- main ------------------------------------------------------------------

while [ $# -gt 0 ]; do
  case "$1" in
    --bottle) [ $# -ge 2 ] || die "--bottle needs a name"; STEAM_BOTTLE="$2"; export STEAM_BOTTLE; shift 2 ;;
    --dry-run|-n) DRY_RUN=1; export DRY_RUN; shift ;;
    --version|-V) echo "mac-mini-frame $VERSION"; exit 0 ;;
    *) break ;;
  esac
done

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  doctor)  cmd_doctor "$@" ;;
  apply)   cmd_apply "$@" ;;
  launch)  cmd_launch "$@" ;;
  flags)   cmd_flags "$@" ;;
  bench)   cmd_bench "$@" ;;
  kill)    cmd_kill ;;
  restore) cmd_restore "$@" ;;
  backups) cmd_backups ;;
  help|-h|--help) usage ;;
  *) err "unknown command: $cmd"; usage >&2; exit 2 ;;
esac
